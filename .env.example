# Copy this file to .env.local for local development, and to .env if you're
# running Prisma CLI commands directly (migrate/seed) — the Prisma CLI only
# reads .env, Next.js only reads .env.local, so keep both in sync.
# On Vercel, set these under Project Settings -> Environment Variables.

# --- Database (required) ---
# Postgres connection string. This project was built against Prisma Postgres
# (db.prisma.io) but any Postgres connection string works.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Admin auth (required) ---
# Signs the admin session JWT. Generate a real random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"

# --- Image uploads (required for the admin Products image uploader) ---
# From a Vercel Blob store created with PUBLIC access (private stores can't
# serve public URLs, which product photos need) — Storage tab in the Vercel
# dashboard -> Create Database -> Blob -> Access: Public.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Site URL (optional but recommended) ---
# The canonical, public URL of the site (no trailing slash). Vercel provides
# a per-deployment URL automatically if unset, but setting this explicitly
# keeps canonical tags/sitemap/OG images pointed at your real domain.
NEXT_PUBLIC_SITE_URL=https://www.safalight.com
