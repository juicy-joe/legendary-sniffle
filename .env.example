# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables
# (Vercel automatically provides a per-deployment URL if you leave this unset,
# but setting it explicitly ensures canonical URLs/sitemap/OG tags always
# point at your real production domain).

# The canonical, public URL of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.safalight.com
