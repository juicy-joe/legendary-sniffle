// SaFaLight admin platform — Phase 1 schema.
// See C:\Users\johan\.claude\plans\ancient-tickling-iverson.md for the plan
// this implements.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  EDITOR
}

enum EnquiryStatus {
  NEW
  READ
  REPLIED
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
}

// Drive the generated SVG "atelier study" illustration used as a fallback
// for products that don't have real photography yet (src/components/LampIllustration.tsx).
enum LampPalette {
  gold
  ivory
  onyx
  bronze
  smoke
}

enum LampShade {
  dome
  drum
  cone
  sphere
  pleated
}

enum LampBase {
  urn
  column
  sculpted
  orb
  disc
}

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           StaffRole @default(EDITOR)
  // Brute-force lockout: failedAttempts resets to 0 on any successful
  // login; lockedUntil is set once attempts cross the threshold (see
  // src/app/admin/login/actions.ts) and cleared on the next success.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Designer {
  id        String    @id @default(cuid())
  name      String
  // Shown on product cards/detail pages instead of the full name when set
  // (e.g. "J. J. Finnbogason" instead of "Johann Julius Finnbogason") —
  // falls back to the full name if left blank, so this is opt-in per
  // designer rather than a second required field.
  shortName String?
  origin    String
  bio       String
  // Controls display order on the About page's designer grid — lower
  // shows first. Ties break by name (see getDesigners()).
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  price           Int
  materials       String
  dimensions      String
  description     String
  story           String
  featured        Boolean @default(false)
  limited         Boolean @default(false)
  metaTitle       String?
  metaDescription String?

  // Fallback SVG illustration params — used when no ProductImage rows exist.
  palette LampPalette
  shade   LampShade
  base    LampBase

  designer     Designer   @relation(fields: [designerId], references: [id])
  designerId   String
  collection   Collection @relation(fields: [collectionId], references: [id])
  collectionId String
  category     Category   @relation(fields: [categoryId], references: [id])
  categoryId   String

  images ProductImage[]

  // Warehouse — current count on hand, and the level below which the
  // warehouse dashboard flags it as low stock. stockQuantity is never
  // edited directly; it only changes via a StockMovement (see below), so
  // the movement log always explains how the current number was reached.
  stockQuantity     Int             @default(0)
  lowStockThreshold Int             @default(3)
  stockMovements    StockMovement[]

  wholesalePrices WholesaleProductPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StockMovementType {
  IN
  OUT
}

// One row per warehouse event — a restock, a correction, or a customer
// shipment. product.stockQuantity is a running total derived from these;
// the log itself is the source of truth (a recount or damage write-off is
// just another movement with an explanatory note, not a raw edit to the
// total).
model StockMovement {
  id        String            @id @default(cuid())
  product   Product           @relation(fields: [productId], references: [id])
  productId String
  type      StockMovementType
  // Always positive — direction comes from `type`, not the sign.
  quantity  Int
  note      String?
  // Only meaningful for IN entries (what was restocked, and at what
  // per-unit cost) — left null for OUT entries and auto-logged shipments.
  supplier String?
  unitCost Int?
  // Set only when this OUT movement was auto-logged by an order actually
  // shipping (see markOrderShipped) — null for anything logged by hand.
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?
  // Who logged it, from the admin session at the time — free text (not a
  // relation) so the log entry still reads correctly even if that staff
  // account is later removed.
  loggedBy  String?
  createdAt DateTime @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  label     String
  swatch    String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())
}

// Singleton content tables — always exactly one row, fixed id, upserted from
// the admin content editors rather than created/deleted like normal records.
model HomeContent {
  id                 String   @id @default("home")
  heroEyebrow        String
  heroHeadline       String
  heroHeadlineAccent String
  heroSubtext        String
  chromaHeadline     String
  chromaSubtext      String
  craftHeadline      String
  craftSubtext       String
  updatedAt          DateTime @updatedAt
}

model AboutContent {
  id           String   @id @default("about")
  heroHeadline String
  heroSubtext  String
  updatedAt    DateTime @updatedAt
}

model ContactInfo {
  id        String   @id @default("contact")
  email     String
  phone     String
  address   String
  hours     String
  updatedAt DateTime @updatedAt
}

model Settings {
  id               String   @id @default("settings")
  siteName         String   @default("SaFaLight")
  siteUrl          String   @default("https://www.safalight.com")
  defaultMetaTitle String?
  defaultMetaDesc  String?

  // Shipping — euros, matching Product.price. Regular within the EU
  // defaults to free but is left editable rather than hardcoded to 0, in
  // case that ever changes. See src/lib/shipping.ts for how these are
  // actually applied (region + speed, decided before a Stripe Checkout
  // Session is created).
  euRegularShippingPrice    Int @default(0)
  euExpressShippingPrice    Int @default(50)
  nonEuRegularShippingPrice Int @default(450)
  nonEuExpressShippingPrice Int @default(650)

  // Applied to every approved wholesale account unless that account has
  // its own discountPercent override (see WholesaleAccount) — one site-
  // wide default rather than having to set it per-account every time.
  wholesaleDefaultDiscountPercent Int @default(20)

  updatedAt DateTime @updatedAt
}

enum WholesaleAccountStatus {
  PENDING
  APPROVED
  REJECTED
}

// A trade/wholesale customer — deliberately its own model with its own
// session system (src/lib/wholesale-session.ts), not a role bolted onto
// AdminUser. Different kind of user (a customer, not staff), different
// blast radius if either auth system ever had a bug.
model WholesaleAccount {
  id           String                 @id @default(cuid())
  businessName String
  contactName  String
  email        String                 @unique
  phone        String?
  vatId        String?
  notes        String? // free text from the application form
  status       WholesaleAccountStatus @default(PENDING)

  // Null until the account is approved and they've set it via the invite
  // link — see inviteToken below. A PENDING or REJECTED account can never
  // log in even if this somehow got set, enforced in the login action,
  // not just by the UI hiding the form.
  passwordHash String?

  // Percent off retail, applied at checkout when no per-product override
  // exists below. Null means "use Settings.wholesaleDefaultDiscountPercent".
  discountPercent Int?

  productPrices        WholesaleProductPrice[]
  orders               Order[]
  specialOrderRequests SpecialOrderRequest[]

  // One-time token emailed on approval so the account holder sets their
  // own password rather than us choosing or emailing one in plaintext.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-account, per-product negotiated price — takes precedence over that
// account's discountPercent when present, so "flat % off" and "negotiated
// per client" can coexist: most products use the percentage, specific
// products can still be pinned to an agreed price.
model WholesaleProductPrice {
  id                 String           @id @default(cuid())
  wholesaleAccount   WholesaleAccount @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  wholesaleAccountId String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId          String
  price              Int // whole euros, matching Product.price

  @@unique([wholesaleAccountId, productId])
}

enum SpecialOrderRequestStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
}

// A trade account asking for something outside the regular catalog — a
// custom spec, a bulk quote, a design they want quoted. Deliberately
// separate from the general Enquiry model (used by the public Contact
// form) so trade requests, which usually need a quote and often carry an
// attached file, don't get mixed into the same inbox as general enquiries.
// The actual back-and-forth happens by email/phone (the account's own
// contact details are right there in admin) — this is a tracked inbox,
// not an in-app messaging thread.
model SpecialOrderRequest {
  id                 String                    @id @default(cuid())
  wholesaleAccount   WholesaleAccount          @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  wholesaleAccountId String
  subject            String
  message            String
  quantity           Int?
  fileUrl            String?
  fileName           String?
  status             SpecialOrderRequestStatus @default(NEW)
  createdAt          DateTime                  @default(now())
}

model MenuItem {
  id        String @id @default(cuid())
  label     String
  href      String
  location  String // "navbar" | "footer-explore" | "footer-collections"
  sortOrder Int    @default(0)
}

model SocialLink {
  id       String @id @default(cuid())
  platform String // "instagram" | "facebook" | "linkedin"
  url      String
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  interest  String
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerName   String
  email          String
  address        String
  city           String
  region         String?
  postal         String
  country        String
  items          Json
  subtotal       Int
  shippingMethod String
  shippingCost   Int
  // Tax is calculated by Stripe Tax at checkout (based on the shipping
  // address entered on Stripe's hosted page), not computed by this app —
  // stored here purely as a record of what was actually charged.
  taxAmount      Int         @default(0)
  total          Int
  status         OrderStatus @default(NEW)
  // The order row is created by the Stripe webhook once payment actually
  // succeeds (checkout.session.completed), never by the client directly —
  // this id is both the link back to Stripe and the idempotency key that
  // stops a retried webhook delivery from creating a duplicate order.
  stripeSessionId String?    @unique
  createdAt      DateTime    @default(now())

  // Set together when an admin marks the order shipped — trackingNumber is
  // the human-readable id shown in the email, trackingUrl is what it links
  // to (the carrier's own tracking page). shippedEmailSentAt is set once
  // the notification actually sends, so the admin UI can tell "not shipped
  // yet" apart from "shipped, notification pending" apart from "customer
  // already notified" (and offer a resend rather than re-sending blindly).
  trackingNumber     String?
  trackingUrl        String?
  shippedEmailSentAt DateTime?

  // Set when this order was placed by a logged-in wholesale account (its
  // checkout session was priced at that account's wholesale rate) — null
  // for ordinary retail orders.
  wholesaleAccount   WholesaleAccount? @relation(fields: [wholesaleAccountId], references: [id])
  wholesaleAccountId String?

  stockMovements StockMovement[]
}
